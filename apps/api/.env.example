# Runtime environment: development | test | production
NODE_ENV=development

# Port the NestJS server listens on.
PORT=4000

# Global API prefix mounted in front of every route.
API_PREFIX=api/v1

# Comma-separated list of origins allowed by CORS (the web and admin apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB connection. In Docker Compose, MONGODB_URI should use the
# "mongo" service name instead of localhost for internal networking.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ag_portfolio
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Rate limiting (ms window / max requests per window).
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
