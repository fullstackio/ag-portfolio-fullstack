    "eslint --fix --no-warn-ignored --config apps/web/eslint.config.mjs"
  ],
  "apps/admin/**/*.{ts,tsx,js,jsx}": [
    "eslint --fix --no-warn-ignored --config apps/admin/eslint.config.mjs"
  ],
  "apps/api/**/*.ts": ["eslint --fix --no-warn-ignored --config apps/api/eslint.config.js"],
  "packages/shared/**/*.{ts,tsx,js,jsx}": [
