# Shared variables consumed by docker-compose.yml / docker-compose.prod.yml.
# Copy to .env and fill in real values before running `pnpm docker:dev` or
# `pnpm docker:prod`. Never commit the resulting .env file.

NODE_ENV=development

# ---- MongoDB ----
MONGODB_DATABASE=ag_portfolio
MONGODB_USERNAME=ag_portfolio_app
MONGODB_PASSWORD=change-me
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-root
# Full connection string used by the API container (service name, not localhost).
MONGODB_URI=mongodb://root:change-me-root@mongo:27017

# ---- API ----
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
API_PORT=4000

# ---- Web / Admin ----
WEB_PORT=3000
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
