# Copy to .env and fill in real values before running `pnpm dev` or
# `pnpm docker:dev` / `pnpm docker:prod`. Never commit the resulting .env file.

NODE_ENV=development

# Port the Next.js server listens on (dev and docker).
PORT=3000

# Comma-separated list of origins allowed to call /api/v1/** cross-origin.
# Same-origin requests from this app's own pages/admin UI don't need this.
CORS_ORIGINS=http://localhost:3000

# ---- MongoDB ----
# In Docker Compose, MONGODB_URI should use the "mongo" service name instead
# of localhost for internal container-to-container networking.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ag_portfolio
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-root
